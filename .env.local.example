# =============================================================================
# ENVIRONMENT VARIABLES — screener-modular (Vercel Deployment Baru)
# =============================================================================
# Copy/rename file ini menjadi ".env.local" lalu isi nilainya untuk dev lokal.
# Di Vercel: Settings → Environment Variables → tambahkan semua yang ada di sini.
# =============================================================================

# ── GitHub Repo (SCREENER-MODULAR yang baru, BUKAN repo lama!) ──
GITHUB_OWNER=username_github_anda
GITHUB_REPO=screener-modular

# ── GitHub Personal Access Token ──
# Buat di: https://github.com/settings/tokens/new
# Centang scope: "workflow" (untuk trigger workflow_dispatch)
# Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN_WORKFLOW=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Keamanan Vercel Cron ──
# Buat string acak panjang (misal: openssl rand -hex 32)
# Set JUGA di Vercel Dashboard agar Vercel Cron bisa mengaksesnya
CRON_SECRET=buat_string_rahasia_panjang_acak_di_sini

# ── Nama file workflow ──
# Default sudah benar, tidak perlu diubah
WORKFLOW_FILE=screener.yml
